{
  "name": "mynotes",
  "version": "1.2.5",
  "description": "美观可定制的 Windows 桌面便签",
  "main": "main.js",
  "author": "MyNotes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:publish": "electron-builder --win --publish always",
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.mynotes.app",
    "productName": "便签",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "data-io.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LucasRiver9527",
        "repo": "Note-Memo",
        "releaseType": "release"
      }
    ],
    "artifactName": "MyNotes-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
